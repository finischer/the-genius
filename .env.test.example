# Copy to .env.test and adjust. Never commit .env.test.

# Dedicated E2E database. The name must end with an allowed test suffix (e.g. _e2e).
DATABASE_URL="postgresql://postgres:password@localhost:5432/the_genius_e2e"
NEXTAUTH_SECRET="e2e-test-secret-change-me"

# Required by src/env.mjs
NODE_ENV="development"
APP_ENV="development"
WEBSITE_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="placeholder"
GOOGLE_CLIENT_SECRET="placeholder"
DISCORD_CLIENT_ID="placeholder"
DISCORD_CLIENT_SECRET="placeholder"
SOCKET_IO_ADMIN_USERNAME="placeholder"
SOCKET_IO_ADMIN_PASSWORD="placeholder"
NEXT_PUBLIC_THE_GENIUS_ENV="development"
NEXT_PUBLIC_PARTYKIT_HOST="127.0.0.1:1999"
NEXT_PUBLIC_POSTHOG_KEY="placeholder"
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# E2E test users (created by bun run db:seed:e2e)
E2E_TEST_EMAIL="e2e-user@example.com"
E2E_TEST_PASSWORD="change-me"
E2E_ADMIN_EMAIL="e2e-admin@example.com"
E2E_ADMIN_PASSWORD="change-me"

# Optional
# E2E_BASE_URL="http://localhost:3000"
# E2E_ALL_BROWSERS="true"
