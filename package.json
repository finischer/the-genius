    "@tiptap/extension-link": "^2.1.13",
    "@tiptap/react": "^2.1.13",
    "@tiptap/starter-kit": "^2.1.13",
    "@trpc/client": "^10.18.0",
    "@trpc/next": "^10.18.0",
    "@trpc/react-query": "^10.18.0",
    "@trpc/server": "^10.18.0",
    "bcryptjs": "^3.0.3",
    "bson": "^5.2.0",
    "canvas-confetti": "^1.9.4",
    "chroma-js": "^2.4.2",
    "dayjs": "^1.11.10",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.0.0",
    "framer-motion": "^10.12.7",
    "handlebars": "^4.7.8",
    "immer": "^10.0.2",
    "lodash": "^4.17.21",
    "migrate-mongo": "^14.0.7",
    "moment": "^2.29.4",
    "mongodb": "^5.7.0",
    "next": "^16.2.10",
    "next-auth": "^4.24.5",
    "next-seo": "^6.4.0",
    "partyserver": "^0.5.10",
    "partysocket": "1.0.0",
