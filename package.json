{
  "name": "the-genius",
  "version": "0.3.10",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "build": "next build",
    "dev": "ENABLE_SEED=true bun run db:seed && next dev",
    "dev:e2e": "next dev",
    "postinstall": "prisma generate --schema prisma",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:generate": "prisma generate --schema prisma",
    "db:migrate": "prisma migrate dev --schema prisma",
    "db:migrate:create": "prisma migrate dev --schema prisma --create-only",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma",
    "db:migrate:status": "prisma migrate status --schema prisma",
    "db:migrate:reset": "prisma migrate reset --schema prisma",
    "db:seed": "ENABLE_SEED=true bun prisma/seed/index.ts",
    "db:seed:e2e": "bun prisma/seed/e2e.ts",
    "start:migrate": "bun run db:migrate:deploy && bun run db:seed && next start",
    "lint": "eslint --config eslint.config.cjs 'src/**/*.{js,jsx,ts,tsx}' 'e2e/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint --config eslint.config.cjs --fix 'src/**/*.{js,jsx,ts,tsx}'",
    "lint:strict": "eslint --config eslint.config.cjs 'src/**/*.{js,jsx,ts,tsx}'",
    "format:all": "prettier --write src/**/*.{ts,tsx,js,jsx,json,md}",
    "start": "next start",
    "tsc": "tsc",
    "party:dev": "wrangler dev --port 1999",
    "party:types": "wrangler types --path party/worker-configuration.d.ts --include-env false",
    "party:tsc": "bun run party:types && tsc -p party/tsconfig.json",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:unit:watch": "vitest tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test --grep @smoke --project=chromium",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@emotion/react": "^11.10.8",
    "@mantine/carousel": "^7.3.2",
    "@mantine/code-highlight": "^7.3.2",
    "@mantine/colors-generator": "^7.3.2",
    "@mantine/core": "^7.3.2",
    "@mantine/dates": "^7.3.2",
    "@mantine/dropzone": "^7.3.2",
