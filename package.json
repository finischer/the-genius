    "@types/migrate-mongo": "^10.0.6",
    "@types/node": "^18.15.5",
    "@types/nodemailer": "^6.4.7",
    "@types/prettier": "^2.7.2",
    "@types/react": "^18.3.18",
    "@types/react-animations": "^1.0.0",
    "@types/react-beautiful-dnd": "^13.1.4",
    "@types/react-dom": "^18.3.5",
