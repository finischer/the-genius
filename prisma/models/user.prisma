model User {
  id                  String       @id @default(cuid())
  name                String
  username            String?      @unique
  role                UserRole?    @default(USER)
  email               String       @unique
  emailVerified       DateTime?
  isEmailVerified     Boolean
  password            String?
  image               String?
  gameshows           Gameshow[]   @relation("gameshowCreator")
  gameshowsOriginated Gameshow[]   @relation("originalCreator")
  friends             Friendship[] @relation("users")
  friendOf            Friendship[] @relation("friendUsers")
  roomsOpen           Room[]       @relation("roomCreator")
  feedback            Feedback[]   @relation("feedbackCreator")
  accounts            Account[]
  sessions            Session[]
  isFirstVisit        Boolean      @default(true)
  lastLoginAt         DateTime     @default(now())
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("users")
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  user      User     @relation("users", fields: [userId], references: [id])
  friend    User     @relation("friendUsers", fields: [friendId], references: [id])
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("friendships")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationTokens")
}
