datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator e2e {
  provider     = "prisma-client"
  output       = "../e2e/.generated/prisma"
  moduleFormat = "cjs"
}

generator json {
  provider  = "prisma-json-types-generator"
  namespace = "PrismaJson"
  allowAny  = false
}
